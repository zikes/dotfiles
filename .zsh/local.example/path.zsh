# This machine's PATH entries, sourced at the end of ~/.zsh/path.zsh for login
# and interactive shells. (N-/) skips a directory that doesn't exist, and
# duplicates are dropped automatically.
#
# path=(
#   $HOME/.cargo/bin(N-/)     # searched before the system directories
#   $path
#   /opt/some-tool/bin(N-/)   # searched after them
# )
